{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "allow-take-pending-file",
    "allow-read-markdown-file",
    "allow-allow-images",
    "allow-load-store",
    "allow-save-store",
    "allow-paths-exist",
    "allow-open-path",
    "allow-open-url",
    "allow-open-in-editor"
  ]
}
